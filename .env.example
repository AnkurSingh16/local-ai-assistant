# Copy to .env and change what you need. Every variable is optional;
# see docs/reference/configuration.md.

# NODE_ENV=development
# HOST=127.0.0.1
# PORT=8787
# WEB_PORT=5173 (set it on the command line too: the web dev server does not read .env)
# LOG_LEVEL=info
# PROVIDERS=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# CHAT_MODEL=qwen2.5:7b
# GUARD_MODEL=llama-guard3:1b
# OLLAMA_KEEP_ALIVE=30m
# GUARD_TIMEOUT_MS=20000
# GUARD_WARM_TIMEOUT_MS=2000
# SEARXNG_URL=http://127.0.0.1:8888
# SEARCH_TIMEOUT_MS=5000
# TURN_TIMEOUT_MS=60000
# ALLOWED_HOSTS=localhost:8787,127.0.0.1:8787
# ALLOWED_ORIGINS=http://localhost:<WEB_PORT>,http://127.0.0.1:<WEB_PORT>
# RATE_LIMIT_PER_IP=60
# RATE_LIMIT_WINDOW_MS=600000
# MAX_CONCURRENT_TURNS=2
# MAX_QUEUED_TURNS=4

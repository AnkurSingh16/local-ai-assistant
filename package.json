{
  "name": "local-ai-assistant",
  "version": "0.0.0",
  "private": true,
  "description": "A free, local general-purpose AI assistant with web search, citations and layered guardrails.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n api,web -c blue,green \"npm run dev -w @local-ai/api\" \"npm run dev -w @local-ai/web\"",
    "predev": "npm run searxng:up && npm run doctor",
    "doctor": "npm run doctor -w @local-ai/api",
    "searxng:up": "node scripts/searxng-up.mjs",
    "searxng:down": "docker compose down",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && tsc -p eslint-rules && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b && npm run build -w @local-ai/web",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run depcruise && npm run test:coverage",
    "prepare": "husky",
    "e2e": "npm run e2e -w @local-ai/web",
    "eval:redteam": "npm run redteam -w @local-ai/eval",
    "eval:redteam:live": "npm run redteam:live -w @local-ai/eval --",
    "eval:record": "npm run record -w @local-ai/eval --"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/rule-tester": "^8.72.2",
    "@typescript-eslint/utils": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  },
  "allowScripts": {
    "fsevents": false
  }
}

{
  "name": "@local-ai/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@local-ai/source --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "tsx --conditions=@local-ai/source --env-file-if-exists=../../.env src/doctor.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@local-ai/agent": "0.0.0",
    "@local-ai/contract": "0.0.0",
    "@local-ai/core": "0.0.0",
    "@local-ai/guardrails": "0.0.0",
    "@local-ai/providers": "0.0.0",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^5.5.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
